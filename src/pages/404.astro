---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for could not be found."
  path="/404"
>
  <main class="not-found" aria-labelledby="not-found-title">
    <div class="not-found__inner">
      <p class="not-found__label" aria-hidden="true">
        <span class="not-found__slash">/</span>404
      </p>
      <h1 id="not-found-title">
        <span class="reveal-mask">
          <span class="reveal-line">This page slipped</span>
        </span>
        <span class="reveal-mask">
          <span class="reveal-line" style="--reveal-delay: 90ms">out of frame.</span>
        </span>
      </h1>
      <p class="settle" style="--i: 0">
        The route is missing, moved, or still waiting to be written. The homepage is the
        shortest path back to the work.
      </p>
      <a href="/" class="not-found__link settle draw-link" style="--i: 1">Return home</a>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 100svh;
    place-items: center;
    padding: clamp(2rem, 8vw, var(--spacing-18)) 1.5rem;
  }

  .not-found__inner {
    width: min(100%, 42rem);
  }

  .not-found__label {
    margin: 0 0 1.25rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
  }

  .not-found__slash {
    color: var(--color-accent);
    margin-right: 0.2em;
  }

  .not-found h1 {
    margin: 0;
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 0.98;
  }

  .not-found p:not(.not-found__label) {
    max-width: 32rem;
    margin: 1.75rem 0 0;
    color: var(--color-text);
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .not-found__link {
    display: inline-flex;
    align-items: center;
    margin-block-start: 2.25rem;
    border-radius: 2px;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .not-found__link:hover {
    color: var(--color-white);
  }
</style>
