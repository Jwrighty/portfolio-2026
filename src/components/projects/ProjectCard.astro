---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { render } from "astro:content";
import ExternalLink from "../primitives/ExternalLink.astro";
import Tag from "../primitives/Tag.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, description, status, stack, liveUrl, repoUrl, npmUrl, coverImage, screenshots } =
  project.data;
const { Content } = await render(project);
const images = [coverImage, ...(screenshots ?? [])].filter((image) => image != null);
const isPortrait = images.length > 0 && images.every((image) => image.height > image.width);
---

<article class="border-t border-border py-8 first:border-t-0 first:pt-0 last:pb-0">
  <div class="mb-1 flex items-baseline justify-between gap-5">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h3 class="m-0 font-display text-headline font-semibold leading-snug tracking-[-0.01em] text-white">
        {title}
      </h3>
      {status && (
        <span class="font-mono text-label leading-normal text-muted">
          {status}
        </span>
      )}
    </div>
    {liveUrl && (
      <ExternalLink href={liveUrl} tone="accent" class="shrink-0">Visit</ExternalLink>
    )}
  </div>
  <p class="m-0 max-w-[38rem] text-copy leading-[1.65] text-muted [text-wrap:pretty]">
    {description}
  </p>

  <ul class="mt-4 flex list-none flex-wrap gap-1.5 p-0" aria-label={`${title} technology stack`}>
    {stack.map((item) => (
      <li>
        <Tag>{item}</Tag>
      </li>
    ))}
  </ul>

  <details class="group disclosure-details mt-4 text-muted">
    <summary
      class:list={[
        "tap-target flex w-fit cursor-pointer list-none items-center gap-1.5 rounded-[2px]",
        "font-mono text-label leading-normal tracking-[0.06em] text-accent transition-colors duration-200",
        "hover:text-white",
        "[&::-webkit-details-marker]:hidden",
      ]}
    >
      <span
        aria-hidden="true"
        class="text-micro transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-open:rotate-180"
      >
        ▾
      </span>
      Details
    </summary>
    <div class="pt-[18px]">
      {images.length > 0 && isPortrait && (
        <div class="mb-[18px] -mx-1 flex snap-x snap-mandatory gap-2.5 overflow-x-auto px-1 pb-2 [scrollbar-width:thin]">
          {images.map((image) => (
            <Image
              src={image}
              alt={`${title} interface`}
              widths={[160, 320]}
              sizes="160px"
              loading="lazy"
              class="block h-[320px] w-auto shrink-0 snap-start rounded-[3px] border border-border"
            />
          ))}
        </div>
      )}
      {images.length > 0 && !isPortrait && (
        <div class="mb-[18px] flex flex-col gap-2.5">
          {images.map((image) => (
            <Image
              src={image}
              alt={`${title} interface`}
              widths={[400, 600, 900, 1200]}
              sizes="(max-width: 640px) 88vw, 640px"
              loading="lazy"
              class="block w-full rounded-[3px] border border-border"
            />
          ))}
        </div>
      )}
      <div class="project-body max-w-[38rem] text-copy leading-[1.7] text-muted [text-wrap:pretty]">
        <Content />
      </div>
      {(repoUrl || npmUrl) && (
        <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2" aria-label={`${title} links`}>
          {repoUrl && <ExternalLink href={repoUrl}>Repository</ExternalLink>}
          {npmUrl && <ExternalLink href={npmUrl}>npm</ExternalLink>}
        </div>
      )}
    </div>
  </details>
</article>

<style>
  .project-body :global(p) {
    margin: 0;
  }
  .project-body :global(p + p) {
    margin-top: 0.9em;
  }
  .project-body :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }
  .project-body :global(code) {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.9em;
    color: var(--color-text);
  }
</style>
