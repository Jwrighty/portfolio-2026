---
import SocialLinks from '../primitives/SocialLinks.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<header class:list={['mb-24', className]}>
  <h1
    class="m-0 font-display text-[clamp(3rem,9vw,5.25rem)] font-bold leading-[0.95] tracking-[-0.02em] text-white"
  >
    <span class="reveal-mask">
      <span class="reveal-line">Jason</span>
    </span>
    <span class="reveal-mask">
      <span class="reveal-line text-accent" style="--reveal-delay: 90ms">Wright</span>
    </span>
  </h1>

  <p
    class="settle mb-0 mt-7 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[0.74rem] leading-[1.6] tracking-[0.02em] text-muted"
    style="--i: 0"
  >
    <span class="inline-flex items-center gap-2 uppercase tracking-[0.08em] text-accent">
      <span aria-hidden="true" class="status-dot h-[7px] w-[7px] rounded-full bg-accent"></span>
      Open to new roles
    </span>
    <span>Senior / Principal Frontend Engineer · Tokyo → London, 2026</span>
  </p>

  <div
    class="settle mt-8 max-w-[36rem] space-y-4 text-[0.98rem] leading-[1.75] text-text [text-wrap:pretty]"
    style="--i: 1"
  >
    <p>
      Senior frontend engineer with 8+ years building and modernising large-scale web
      applications in React, TypeScript, and Next.js, supported by 7 years of earlier
      business leadership at Amazon.
    </p>
  </div>

  <div class="settle mt-9" style="--i: 2">
    <SocialLinks class="gap-6" />
  </div>
</header>
