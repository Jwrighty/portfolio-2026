---
import SocialLinks from "../primitives/SocialLinks.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<footer
  class:list={[
    "mt-12 flex flex-wrap items-center justify-between gap-4",
    className,
  ]}
>
  <p class="m-0 font-mono text-meta leading-[1.6] tracking-[0.05em] text-muted">
    Open to remote, hybrid &amp; on-site roles · UK right to work
  </p>
  <SocialLinks class="gap-6" />
</footer>
