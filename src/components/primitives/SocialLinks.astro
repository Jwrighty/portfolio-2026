---
import { site } from "../../data/site.ts";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const links = [
  { label: "GitHub", href: site.social.github },
  { label: "LinkedIn", href: site.social.linkedin },
];
---

<nav aria-label="Social links" class:list={["flex gap-4", className]}>
  {
    links.map(({ label, href }) => (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[
          "group/link tap-target inline-flex items-center gap-1 rounded-[2px] font-mono text-meta leading-normal tracking-[0.04em]",
          "draw-link text-muted hover:text-accent",
        ]}
      >
        {label}
        <span
          aria-hidden="true"
          class="text-micro transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover/link:-translate-y-[2px] group-hover/link:translate-x-[2px]"
        >
          ↗
        </span>
      </a>
    ))
  }
</nav>
