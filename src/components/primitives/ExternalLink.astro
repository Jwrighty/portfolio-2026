---
interface Props {
  href: string;
  target?: string;
  /** "muted" (default) rests muted and warms to accent on hover; "accent" rests accent and lifts to white. */
  tone?: "muted" | "accent";
  class?: string;
}
const { href, target = "_blank", tone = "muted", class: className } = Astro.props;

const rel = target === "_blank" ? "noopener noreferrer" : undefined;
const toneClass =
  tone === "accent" ? "text-accent hover:text-white" : "text-muted hover:text-accent";
---

<a
  href={href}
  target={target}
  rel={rel}
  class:list={[
    "group/link tap-target inline-flex items-center gap-1 rounded-[2px] font-mono text-meta leading-normal tracking-[0.04em]",
    "draw-link",
    toneClass,
    className,
  ]}
>
  <slot />
  {target === "_blank" && (
    <span
      aria-hidden="true"
      class="text-micro transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover/link:-translate-y-[2px] group-hover/link:translate-x-[2px]"
    >
      ↗
    </span>
  )}
</a>
