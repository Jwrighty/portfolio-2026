---
interface Props {
  href: string;
  target?: string;
  class?: string;
}
const { href, target = "_blank", class: className } = Astro.props;

const rel = target === "_blank" ? "noopener noreferrer" : undefined;
---

<a
  href={href}
  target={target}
  rel={rel}
  class:list={[
    "group/link inline-flex items-center gap-1 rounded-[2px] font-mono text-[0.72rem] leading-normal tracking-[0.04em]",
    "draw-link text-muted hover:text-accent",
    className,
  ]}
>
  <slot />
  {target === "_blank" && (
    <span
      aria-hidden="true"
      class="text-[0.6rem] transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover/link:-translate-y-[2px] group-hover/link:translate-x-[2px]"
    >
      ↗
    </span>
  )}
</a>
