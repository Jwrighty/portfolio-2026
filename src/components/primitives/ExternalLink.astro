---
interface Props {
  href: string;
  target?: string;
  class?: string;
}
const { href, target = "_blank", class: className } = Astro.props;

const rel = target === "_blank" ? "noopener noreferrer" : undefined;
---

<a
  href={href}
  target={target}
  rel={rel}
  class:list={[
    "inline-flex items-center gap-1 rounded-[2px] font-mono text-[0.72rem] leading-normal tracking-[0.04em]",
    "text-muted transition-colors duration-200 hover:text-accent",
    "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent",
    className,
  ]}
>
  <slot />
  {target === "_blank" && <span aria-hidden="true" class="text-[0.6rem]">↗</span>}
</a>
