---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span
  class:list={[
    "inline-block whitespace-nowrap rounded-[2px] border border-border px-[7px] py-0.5",
    "font-mono text-[0.63rem] leading-normal tracking-[0.04em] text-muted",
    className,
  ]}
>
  <slot />
</span>
