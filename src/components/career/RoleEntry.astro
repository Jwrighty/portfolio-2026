---
import Tag from "../primitives/Tag.astro";
import type { CareerRole } from "../../data/career";

interface Props {
  role: CareerRole;
  isLast?: boolean;
}

const { role, isLast = false } = Astro.props;
const moreCount = role.achievements.length;
---

<article class:list={["grid gap-2", !isLast && "mb-7"]}>
  <header class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h4 class="m-0 font-sans text-[0.92rem] font-medium leading-normal tracking-normal text-text">
      {role.title}
    </h4>
  </header>

  <p class="m-0 text-[0.85rem] leading-[1.65] text-muted">
    {role.headline}
  </p>

  {moreCount > 0 && (
    <details class="group disclosure-details text-muted">
      <summary
        class:list={[
          "mt-1 flex w-fit cursor-pointer list-none items-center gap-1.5 rounded-[2px]",
          "font-mono text-[0.66rem] leading-normal tracking-[0.06em] text-accent transition-colors duration-200",
          "hover:text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent",
          "[&::-webkit-details-marker]:hidden",
        ]}
      >
        <span aria-hidden="true" class="text-[0.58rem] transition-transform duration-200 group-open:rotate-180">
          ▾
        </span>
        {moreCount} more
      </summary>
      <ul class="mt-3 grid gap-3 text-[0.85rem] leading-[1.65] text-muted">
        {role.achievements.map((achievement) => (
          <li class="grid grid-cols-[auto_1fr] gap-x-2.5">
            <span aria-hidden="true" class="flex h-[1.65em] select-none items-center text-accent">
              <span class="block h-px w-2.5 bg-current"></span>
            </span>
            <span>{achievement}</span>
          </li>
        ))}
      </ul>
    </details>
  )}

  <ul class="mt-1 flex list-none flex-wrap gap-1.5 p-0" aria-label={`${role.title} technology stack`}>
    {role.stack.map((item) => (
      <li>
        <Tag>{item}</Tag>
      </li>
    ))}
  </ul>
</article>
